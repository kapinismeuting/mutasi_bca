# BCA Statement Converter - Environment Configuration
# Copy this to .env and fill in your paths

# ============================================================================
# INPUT/OUTPUT PATHS
# ============================================================================

# Folder containing PDF files to process
PDF_FOLDER=/path/to/pdf/folder

# Folder where Excel files will be saved
OUTPUT_FOLDER=/path/to/output/folder

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional: Log file path (leave empty to disable file logging)
LOG_FILE=

# ============================================================================
# PROCESSING CONFIGURATION
# ============================================================================

# Maximum PDF file size in bytes (100 MB = 104857600)
MAX_PDF_SIZE=104857600

# Create automatic backups before overwriting: true or false
BACKUP_FILES=true

# ============================================================================
# STREAMLIT CONFIGURATION (Optional)
# ============================================================================

# Streamlit server port
STREAMLIT_SERVER_PORT=8501

# Streamlit server address
STREAMLIT_SERVER_ADDRESS=localhost

# ============================================================================
# USAGE
# ============================================================================
# 
# Option 1: Load from .env file (requires python-dotenv)
#   pip install python-dotenv
#   from dotenv import load_dotenv
#   load_dotenv()
#
# Option 2: Export in terminal
#   export PDF_FOLDER=/path/to/pdfs
#   export OUTPUT_FOLDER=/path/to/output
#   streamlit run streamlit_app.py
#
# Option 3: Set directly in Streamlit app
#   Use the text input fields in the interface
#
